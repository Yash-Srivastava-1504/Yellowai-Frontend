# ── Required for the web app (Supabase Dashboard → Project Settings → API) ──
# Project URL: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# "anon" "public" key — safe to expose in the browser; never use the service_role key here.
VITE_SUPABASE_ANON_KEY=
# Instant signup/login (no inbox step): Authentication → Providers → Email → turn OFF “Confirm email”

# Manah Node backend (companion AI via Qubrid) — no trailing slash
VITE_API_URL=http://localhost:3001

# ── Not used by this Vite app (server / SQL tools only) ──
# Direct Postgres URI — keep secret, never prefix with VITE_
# postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-....pooler.supabase.com:5432/postgres
